import React, { useState, useEffect, useRef } from 'react';

// ============================================================================
// VT-102 TERMINAL EMULATOR
// ============================================================================
const VT102Terminal = ({ lines, cursorRow, cursorCol, cursorVisible }) => {
  const ROWS = 24;
  const COLS = 80;

  const displayLines = [...lines];
  while (displayLines.length < ROWS) {
    displayLines.push('');
  }

  return (
    <div className="bg-black p-4 rounded-lg font-mono text-sm overflow-hidden">
      <div className="text-green-400">
        {displayLines.slice(0, ROWS).map((line, rowIndex) => {
          const paddedLine = (line || '').padEnd(COLS, ' ');
          
          return (
            <div key={rowIndex} className="whitespace-pre leading-tight">
              {paddedLine.split('').map((char, colIndex) => {
                const isCursor = cursorVisible && rowIndex === cursorRow && colIndex === cursorCol;
                return (
                  <span
                    key={colIndex}
                    className={isCursor ? 'bg-green-400 text-black' : ''}
                  >
                    {char}
                  </span>
                );
              })}
            </div>
          );
        })}
      </div>
    </div>
  );
};

// ============================================================================
// ENHANCED LEXER - Now with FOR, NEXT, GOSUB, arrays, and built-in functions
// ============================================================================
class Lexer {
  constructor(source) {
    this.source = source;
    this.pos = 0;
    this.currentChar = this.source[0] || null;
  }

  advance() {
    this.pos++;
    this.currentChar = this.pos < this.source.length ? this.source[this.pos] : null;
  }

  peek(ahead = 1) {
    const peekPos = this.pos + ahead;
    return peekPos < this.source.length ? this.source[peekPos] : null;
  }

  skipWhitespace() {
    while (this.currentChar && /\s/.test(this.currentChar) && this.currentChar !== '\n') {
      this.advance();
    }
  }

  skipComment() {
    if (this.currentChar === "'") {
      while (this.currentChar && this.currentChar !== '\n') {
        this.advance();
      }
    }
  }

  readNumber() {
    let numStr = '';
    let hasDecimal = false;
    
    while (this.currentChar && (/\d/.test(this.currentChar) || this.currentChar === '.')) {
      if (this.currentChar === '.') {
        if (hasDecimal) break;
        hasDecimal = true;
      }
      numStr += this.currentChar;
      this.advance();
    }
    
    return hasDecimal ? parseFloat(numStr) : parseInt(numStr, 10);
  }

  readString() {
    let str = '';
    this.advance(); // Skip opening quote
    
    while (this.currentChar && this.currentChar !== '"') {
      if (this.currentChar === '"' && this.peek() === '"') {
        str += '"';
        this.advance();
        this.advance();
      } else {
        str += this.currentChar;
        this.advance();
      }
    }
    
    if (this.currentChar === '"') {
      this.advance();
    }
    
    return str;
  }

  readIdentifier() {
    let id = '';
    
    while (this.currentChar && /[a-zA-Z0-9._]/.test(this.currentChar)) {
      id += this.currentChar;
      this.advance();
    }
    
    // Check for type suffix
    if (this.currentChar === '$' || this.currentChar === '%') {
      id += this.currentChar;
      this.advance();
    }
    
    return id.toUpperCase();
  }

  tokenize() {
    const tokens = [];
    let lineNumber = 1;
    
    while (this.currentChar !== null) {
      // Track line numbers for error reporting
      const currentLine = lineNumber;
      const currentPos = this.pos;
      
      if (/[ \t\r]/.test(this.currentChar)) {
        this.skipWhitespace();
        continue;
      }

      if (this.currentChar === "'") {
        this.skipComment();
        continue;
      }

      if (this.currentChar === '\n') {
        tokens.push({ type: 'NEWLINE', value: '\n', line: lineNumber });
        lineNumber++;
        this.advance();
        continue;
      }

      if (this.currentChar === '\\') {
        this.advance();
        if (this.currentChar === '\n') {
          lineNumber++;
          this.advance();
          continue;
        }
      }

      if (this.currentChar === '"') {
        tokens.push({ type: 'STRING', value: this.readString(), line: currentLine });
        continue;
      }

      // Handle numbers starting with a digit OR a decimal point
      if (/\d/.test(this.currentChar) || (this.currentChar === '.' && /\d/.test(this.peek()))) {
        tokens.push({ type: 'NUMBER', value: this.readNumber(), line: currentLine });
        continue;
      }

      if (this.currentChar === '+') {
        tokens.push({ type: 'PLUS', value: '+', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === '-') {
        tokens.push({ type: 'MINUS', value: '-', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === '*') {
        tokens.push({ type: 'MULTIPLY', value: '*', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === '/') {
        tokens.push({ type: 'DIVIDE', value: '/', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === '^') {
        tokens.push({ type: 'POWER', value: '^', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === '(') {
        tokens.push({ type: 'LPAREN', value: '(', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === ')') {
        tokens.push({ type: 'RPAREN', value: ')', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === ',') {
        tokens.push({ type: 'COMMA', value: ',', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === ';') {
        tokens.push({ type: 'SEMICOLON', value: ';', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === ':') {
        tokens.push({ type: 'COLON', value: ':', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === '@') {
        tokens.push({ type: 'AT', value: '@', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === '=') {
        tokens.push({ type: 'EQUALS', value: '=', line: currentLine });
        this.advance();
        continue;
      }

      if (this.currentChar === '<') {
        this.advance();
        if (this.currentChar === '=') {
          tokens.push({ type: 'LTE', value: '<=', line: currentLine });
          this.advance();
        } else if (this.currentChar === '>') {
          tokens.push({ type: 'NEQ', value: '<>', line: currentLine });
          this.advance();
        } else {
          tokens.push({ type: 'LT', value: '<', line: currentLine });
        }
        continue;
      }

      if (this.currentChar === '>') {
        this.advance();
        if (this.currentChar === '=') {
          tokens.push({ type: 'GTE', value: '>=', line: currentLine });
          this.advance();
        } else {
          tokens.push({ type: 'GT', value: '>', line: currentLine });
        }
        continue;
      }

      if (/[a-zA-Z]/.test(this.currentChar)) {
        const id = this.readIdentifier();
        const keywords = [
          'PRINT', 'INPUT', 'IF', 'THEN', 'ELSE', 'FOR', 'TO', 'STEP', 
          'NEXT', 'WHILE', 'WEND', 'DEF', 'FEND', 'RETURN', 'GOTO', 
          'GOSUB', 'END', 'REM', 'LET', 'DIM', 'STRING', 'INTEGER',
          'AND', 'OR', 'NOT', 'MOD', 'ON', 'STOP', 'DATA', 'READ',
          'RESTORE', 'CLEAR', 'CLS'
        ];
        
        if (keywords.includes(id)) {
          tokens.push({ type: id, value: id, line: currentLine });
        } else {
          tokens.push({ type: 'IDENTIFIER', value: id, line: currentLine });
        }
        continue;
      }

      // Better error message for unknown characters
      const errorMsg = `Unknown character: '${this.currentChar}' (ASCII ${this.currentChar.charCodeAt(0)})`;
      throw new Error(`Syntax Error on line ${lineNumber}: ${errorMsg}\n` +
                     `Position in source: ${currentPos}\n` +
                     `Context: ...${this.source.substring(Math.max(0, currentPos - 20), currentPos + 20)}...\n` +
                     `Suggestion: Check for unsupported characters or typos.`);
    }

    tokens.push({ type: 'EOF', value: null, line: lineNumber });
    return tokens;
  }
}

// ============================================================================
// ENHANCED PARSER - Now handles FOR/NEXT, GOSUB/RETURN, arrays, ON GOTO
// ============================================================================
class Parser {
  constructor(tokens) {
    this.tokens = tokens;
    this.pos = 0;
    this.currentToken = this.tokens[0];
  }

  advance() {
    this.pos++;
    this.currentToken = this.pos < this.tokens.length ? this.tokens[this.pos] : { type: 'EOF', value: null };
  }

  peek(ahead = 1) {
    const peekPos = this.pos + ahead;
    return peekPos < this.tokens.length ? this.tokens[peekPos] : { type: 'EOF', value: null };
  }

  expect(type) {
    if (this.currentToken.type !== type) {
      const line = this.currentToken.line || 'unknown';
      throw new Error(
        `Syntax Error on line ${line}: Expected ${type}, but got ${this.currentToken.type}\n` +
        `Token value: '${this.currentToken.value}'\n` +
        `Suggestion: Check for missing or incorrect syntax near '${this.currentToken.value}'.`
      );
    }
    const token = this.currentToken;
    this.advance();
    return token;
  }

  skipNewlines() {
    while (this.currentToken.type === 'NEWLINE') {
      this.advance();
    }
  }

  parse() {
    const statements = [];
    
    this.skipNewlines();
    
    while (this.currentToken.type !== 'EOF') {
      if (this.currentToken.type === 'NEWLINE') {
        this.advance();
        continue;
      }
      
      // Handle multiple statements on one line (colon separator)
      const lineStatements = this.parseStatementLine();
      statements.push(...lineStatements);
      this.skipNewlines();
    }
    
    return { type: 'Program', statements };
  }

  parseStatementLine() {
    const statements = [];
    
    while (this.currentToken.type !== 'NEWLINE' && this.currentToken.type !== 'EOF') {
      statements.push(this.parseStatement());
      
      if (this.currentToken.type === 'COLON') {
        this.advance(); // Skip colon
      } else {
        break;
      }
    }
    
    return statements;
  }

  parseStatement() {
    // Skip newlines at start of statement
    while (this.currentToken.type === 'NEWLINE') {
      this.advance();
    }
    
    // Check for label
    if (this.currentToken.type === 'IDENTIFIER' && this.peek().type === 'COLON') {
      const label = this.currentToken.value;
      this.advance(); // skip identifier
      this.advance(); // skip colon
      return { type: 'Label', name: label };
    }

    switch (this.currentToken.type) {
      case 'PRINT':
        return this.parsePrint();
      case 'INPUT':
        return this.parseInput();
      case 'LET':
        this.advance();
        return this.parseAssignment();
      case 'IF':
        return this.parseIf();
      case 'FOR':
        return this.parseFor();
      case 'NEXT':
        return this.parseNext();
      case 'WHILE':
        return this.parseWhile();
      case 'WEND':
        this.advance();
        return { type: 'Wend' };
      case 'DEF':
        return this.parseDef();
      case 'FEND':
        this.advance();
        return { type: 'FEnd' };
      case 'RETURN':
        this.advance();
        return { type: 'Return' };
      case 'GOTO':
        return this.parseGoto();
      case 'GOSUB':
        return this.parseGosub();
      case 'ON':
        return this.parseOn();
      case 'DIM':
        return this.parseDim();
      case 'END':
        this.advance();
        return { type: 'End' };
      case 'STOP':
        this.advance();
        return { type: 'Stop' };
      case 'REM':
        // Skip rest of line
        while (this.currentToken.type !== 'NEWLINE' && this.currentToken.type !== 'EOF') {
          this.advance();
        }
        return { type: 'Rem' };
      case 'IDENTIFIER':
        return this.parseAssignment();
      default:
        throw new Error(`Unexpected statement: ${this.currentToken.type}`);
    }
  }

  parsePrint() {
    this.advance(); // skip PRINT
    
    // Check for cursor positioning: PRINT @row,col
    let cursorRow = null;
    let cursorCol = null;
    
    if (this.currentToken.type === 'AT') {
      this.advance(); // skip @
      cursorRow = this.parseExpression();
      this.expect('COMMA');
      cursorCol = this.parseExpression();
    }
    
    // Check for CLS
    let clearScreen = false;
    if (this.currentToken.type === 'CLS') {
      clearScreen = true;
      this.advance();
      return { type: 'Print', items: [], separators: [], clearScreen: true, cursorRow: null, cursorCol: null };
    }
    
    const items = [];
    const separators = [];
    
    while (this.currentToken.type !== 'NEWLINE' && 
           this.currentToken.type !== 'EOF' && 
           this.currentToken.type !== 'COLON') {
      items.push(this.parseExpression());
      
      if (this.currentToken.type === 'SEMICOLON') {
        separators.push(';');
        this.advance();
      } else if (this.currentToken.type === 'COMMA') {
        separators.push(',');
        this.advance();
      } else {
        break;
      }
    }
    
    return { type: 'Print', items, separators, clearScreen: false, cursorRow, cursorCol };
  }

  parseInput() {
    this.advance(); // skip INPUT
    
    let prompt = null;
    
    if (this.currentToken.type === 'STRING') {
      prompt = this.currentToken.value;
      this.advance();
      
      if (this.currentToken.type === 'SEMICOLON') {
        this.advance();
      }
    }
    
    const variables = [];
    
    do {
      if (this.currentToken.type === 'COMMA') {
        this.advance();
      }
      
      if (this.currentToken.type === 'IDENTIFIER') {
        variables.push(this.currentToken.value);
        this.advance();
      }
    } while (this.currentToken.type === 'COMMA');
    
    return { type: 'Input', prompt, variables };
  }

  parseAssignment() {
    const variable = this.currentToken.value;
    this.advance();
    
    // Handle array subscripts
    const subscripts = [];
    if (this.currentToken.type === 'LPAREN') {
      this.advance();
      do {
        if (this.currentToken.type === 'COMMA') {
          this.advance();
        }
        subscripts.push(this.parseExpression());
      } while (this.currentToken.type === 'COMMA');
      this.expect('RPAREN');
    }
    
    this.expect('EQUALS');
    const expression = this.parseExpression();
    
    return { type: 'Assignment', variable, subscripts, expression };
  }

  parseIf() {
    this.advance(); // skip IF
    
    const condition = this.parseExpression();
    
    this.expect('THEN');
    
    if (this.currentToken.type === 'NEWLINE') {
      this.skipNewlines();
    }
    
    const thenBranch = [];
    const elseBranch = [];
    
    // Parse THEN branch (can be multiple statements with colons)
    while (this.currentToken.type !== 'ELSE' && 
           this.currentToken.type !== 'NEWLINE' && 
           this.currentToken.type !== 'EOF') {
      thenBranch.push(this.parseStatement());
      
      if (this.currentToken.type === 'COLON') {
        this.advance();
      } else {
        break;
      }
    }
    
    // Parse ELSE branch if present
    if (this.currentToken.type === 'ELSE') {
      this.advance();
      
      if (this.currentToken.type === 'NEWLINE') {
        this.skipNewlines();
      }
      
      while (this.currentToken.type !== 'NEWLINE' && 
             this.currentToken.type !== 'EOF' &&
             this.currentToken.type !== 'COLON') {
        elseBranch.push(this.parseStatement());
      }
    }
    
    return { type: 'If', condition, thenBranch, elseBranch };
  }

  parseFor() {
    this.advance(); // skip FOR
    
    const variable = this.currentToken.value;
    this.advance();
    
    this.expect('EQUALS');
    
    const start = this.parseExpression();
    
    this.expect('TO');
    
    const end = this.parseExpression();
    
    let step = { type: 'Number', value: 1 };
    if (this.currentToken.type === 'STEP') {
      this.advance();
      step = this.parseExpression();
    }
    
    return { type: 'For', variable, start, end, step };
  }

  parseNext() {
    this.advance(); // skip NEXT
    
    let variable = null;
    if (this.currentToken.type === 'IDENTIFIER') {
      variable = this.currentToken.value;
      this.advance();
    }
    
    return { type: 'Next', variable };
  }

  parseWhile() {
    this.advance(); // skip WHILE
    
    const condition = this.parseExpression();
    
    return { type: 'While', condition };
  }

  parseDef() {
    this.advance(); // skip DEF
    
    const name = this.currentToken.value;
    this.advance();
    
    let parameters = [];
    
    if (this.currentToken.type === 'LPAREN') {
      this.advance();
      
      while (this.currentToken.type !== 'RPAREN') {
        if (this.currentToken.type === 'IDENTIFIER') {
          parameters.push(this.currentToken.value);
          this.advance();
        }
        
        if (this.currentToken.type === 'COMMA') {
          this.advance();
        }
      }
      
      this.expect('RPAREN');
    }
    
    // Check if it's a single-line function
    if (this.currentToken.type === 'EQUALS') {
      this.advance();
      const expression = this.parseExpression();
      return { type: 'DefSingleLine', name, parameters, expression };
    }
    
    // Multi-line function
    this.skipNewlines();
    
    const body = [];
    
    while (this.currentToken.type !== 'FEND' && this.currentToken.type !== 'EOF') {
      if (this.currentToken.type === 'NEWLINE') {
        this.advance();
        continue;
      }
      body.push(this.parseStatement());
    }
    
    if (this.currentToken.type === 'FEND') {
      this.advance();
    }
    
    return { type: 'DefMultiLine', name, parameters, body };
  }

  parseGoto() {
    this.advance(); // skip GOTO
    
    const label = this.currentToken.value;
    this.advance();
    
    return { type: 'Goto', label };
  }

  parseGosub() {
    this.advance(); // skip GOSUB
    
    const label = this.currentToken.value;
    this.advance();
    
    return { type: 'Gosub', label };
  }

  parseOn() {
    this.advance(); // skip ON
    
    const expression = this.parseExpression();
    
    if (this.currentToken.type === 'GOTO') {
      this.advance();
      
      const labels = [];
      do {
        if (this.currentToken.type === 'COMMA') {
          this.advance();
        }
        labels.push(this.currentToken.value);
        this.advance();
      } while (this.currentToken.type === 'COMMA');
      
      return { type: 'OnGoto', expression, labels };
    } else if (this.currentToken.type === 'GOSUB') {
      this.advance();
      
      const labels = [];
      do {
        if (this.currentToken.type === 'COMMA') {
          this.advance();
        }
        labels.push(this.currentToken.value);
        this.advance();
      } while (this.currentToken.type === 'COMMA');
      
      return { type: 'OnGosub', expression, labels };
    }
    
    throw new Error('Expected GOTO or GOSUB after ON');
  }

  parseDim() {
    this.advance(); // skip DIM
    
    const arrays = [];
    
    do {
      if (this.currentToken.type === 'COMMA') {
        this.advance();
      }
      
      const name = this.currentToken.value;
      this.advance();
      
      this.expect('LPAREN');
      
      const dimensions = [];
      do {
        if (this.currentToken.type === 'COMMA') {
          this.advance();
        }
        dimensions.push(this.parseExpression());
      } while (this.currentToken.type === 'COMMA');
      
      this.expect('RPAREN');
      
      arrays.push({ name, dimensions });
    } while (this.currentToken.type === 'COMMA');
    
    return { type: 'Dim', arrays };
  }

  parseExpression() {
    return this.parseLogical();
  }

  parseLogical() {
    let left = this.parseComparison();
    
    while (['AND', 'OR'].includes(this.currentToken.type)) {
      const operator = this.currentToken.value;
      this.advance();
      const right = this.parseComparison();
      left = { type: 'LogicalOp', operator, left, right };
    }
    
    return left;
  }

  parseComparison() {
    let left = this.parseAdditive();
    
    while (['LT', 'GT', 'LTE', 'GTE', 'EQUALS', 'NEQ'].includes(this.currentToken.type)) {
      const operator = this.currentToken.value;
      this.advance();
      const right = this.parseAdditive();
      left = { type: 'BinaryOp', operator, left, right };
    }
    
    return left;
  }

  parseAdditive() {
    let left = this.parseMultiplicative();
    
    while (['PLUS', 'MINUS'].includes(this.currentToken.type)) {
      const operator = this.currentToken.value;
      this.advance();
      const right = this.parseMultiplicative();
      left = { type: 'BinaryOp', operator, left, right };
    }
    
    return left;
  }

  parseMultiplicative() {
    let left = this.parsePower();
    
    while (['MULTIPLY', 'DIVIDE', 'MOD'].includes(this.currentToken.type)) {
      const operator = this.currentToken.value;
      this.advance();
      const right = this.parsePower();
      left = { type: 'BinaryOp', operator, left, right };
    }
    
    return left;
  }

  parsePower() {
    let left = this.parsePrimary();
    
    if (this.currentToken.type === 'POWER') {
      this.advance();
      const right = this.parsePower(); // Right associative
      return { type: 'BinaryOp', operator: '^', left, right };
    }
    
    return left;
  }

  parsePrimary() {
    if (this.currentToken.type === 'NUMBER') {
      const value = this.currentToken.value;
      this.advance();
      return { type: 'Number', value };
    }
    
    if (this.currentToken.type === 'STRING') {
      const value = this.currentToken.value;
      this.advance();
      return { type: 'String', value };
    }
    
    if (this.currentToken.type === 'IDENTIFIER') {
      const name = this.currentToken.value;
      this.advance();
      
      // Check for function call or array access
      if (this.currentToken.type === 'LPAREN') {
        this.advance();
        const args = [];
        
        while (this.currentToken.type !== 'RPAREN') {
          args.push(this.parseExpression());
          
          if (this.currentToken.type === 'COMMA') {
            this.advance();
          }
        }
        
        this.expect('RPAREN');
        
        // Check if it's a built-in function
        const builtins = [
          'RND', 'INT', 'SQR', 'ABS', 'SGN', 'SIN', 'COS', 'TAN', 'ATN',
          'EXP', 'LOG', 'LEFT$', 'RIGHT$', 'MID$', 'LEN', 'STR$', 'CHR$',
          'ASC', 'VAL', 'TAB', 'FNR', 'FND'
        ];
        
        if (builtins.includes(name) || name.startsWith('FN')) {
          return { type: 'BuiltinCall', name, arguments: args };
        }
        
        // Could be array access or function call
        return { type: 'ArrayOrFunction', name, arguments: args };
      }
      
      return { type: 'Variable', name };
    }
    
    if (this.currentToken.type === 'LPAREN') {
      this.advance();
      const expr = this.parseExpression();
      this.expect('RPAREN');
      return expr;
    }
    
    if (this.currentToken.type === 'MINUS') {
      this.advance();
      const expr = this.parsePrimary();
      return { type: 'UnaryOp', operator: '-', operand: expr };
    }
    
    if (this.currentToken.type === 'NOT') {
      this.advance();
      const expr = this.parsePrimary();
      return { type: 'UnaryOp', operator: 'NOT', operand: expr };
    }
    
    throw new Error(`Unexpected token: ${this.currentToken.type}`);
  }
}

// ============================================================================
// ENHANCED INTERPRETER - Full Stage 2 & 3 implementation
// ============================================================================
class Interpreter {
  constructor(terminal) {
    this.terminal = terminal;
    this.variables = new Map();
    this.arrays = new Map();
    this.functions = new Map();
    this.labels = new Map();
    this.callStack = [];
    this.forStack = [];
    this.whileStack = [];
    this.programCounter = 0;
    this.statements = [];
    this.isRunning = false;
    this.waitingForInput = false;
    this.inputCallback = null;
    this.inputVariables = [];
    this.inputPrompt = '';
    this.rndSeed = Math.random();
  }

  reset() {
    this.variables.clear();
    this.arrays.clear();
    this.functions.clear();
    this.labels.clear();
    this.callStack = [];
    this.forStack = [];
    this.whileStack = [];
    this.programCounter = 0;
    this.statements = [];
    this.isRunning = false;
    this.waitingForInput = false;
    this.rndSeed = Math.random();
  }

  async execute(ast) {
    this.reset();
    this.statements = ast.statements;
    this.isRunning = true;
    
    // First pass: collect labels and function definitions
    this.statements.forEach((stmt, index) => {
      if (stmt.type === 'Label') {
        this.labels.set(stmt.name, index);
      } else if (stmt.type === 'DefSingleLine' || stmt.type === 'DefMultiLine') {
        this.functions.set(stmt.name, stmt);
      }
    });
    
    // Second pass: execute statements
    this.programCounter = 0;
    
    while (this.isRunning && this.programCounter < this.statements.length) {
      const stmt = this.statements[this.programCounter];
      
      try {
        await this.executeStatement(stmt);
      } catch (error) {
        // Enhanced runtime error with context
        const stmtIndex = this.programCounter;
        const nearbyLabels = [];
        
        // Find nearby labels for context
        for (let i = Math.max(0, stmtIndex - 5); i <= Math.min(this.statements.length - 1, stmtIndex + 2); i++) {
          if (this.statements[i] && this.statements[i].type === 'Label') {
            nearbyLabels.push(this.statements[i].name);
          }
        }
        
        const contextLabel = nearbyLabels.length > 0 ? nearbyLabels[nearbyLabels.length - 1] : 'unknown';
        
        let errorDetails = `Runtime Error at statement ${this.programCounter}`;
        if (contextLabel !== 'unknown') {
          errorDetails += ` (near label: ${contextLabel})`;
        }
        errorDetails += `:\n\n${error.message}\n`;
        errorDetails += `\nStatement type: ${stmt.type}`;
        
        // Add variable state for debugging
        if (this.variables.size > 0) {
          errorDetails += `\n\nCurrent variables:`;
          let varCount = 0;
          for (const [name, value] of this.variables) {
            if (varCount < 10) { // Show first 10 variables
              errorDetails += `\n  ${name} = ${value}`;
              varCount++;
            }
          }
          if (this.variables.size > 10) {
            errorDetails += `\n  ... and ${this.variables.size - 10} more`;
          }
        }
        
        errorDetails += `\n\nSuggestion: Check the logic near label '${contextLabel}'.`;
        
        this.terminal.println(errorDetails);
        this.isRunning = false;
        break;
      }
      
      this.programCounter++;
    }
  }

  async executeStatement(stmt) {
    if (!stmt) return;
    
    switch (stmt.type) {
      case 'Label':
      case 'Rem':
        // No operation
        break;
        
      case 'Print':
        this.executePrint(stmt);
        break;
        
      case 'Input':
        await this.executeInput(stmt);
        break;
        
      case 'Assignment':
        this.executeAssignment(stmt);
        break;
        
      case 'If':
        this.executeIf(stmt);
        break;
        
      case 'For':
        this.executeFor(stmt);
        break;
        
      case 'Next':
        this.executeNext(stmt);
        break;
        
      case 'While':
        this.executeWhile(stmt);
        break;
        
      case 'Wend':
        this.executeWend();
        break;
        
      case 'Goto':
        this.executeGoto(stmt);
        break;
        
      case 'Gosub':
        this.executeGosub(stmt);
        break;
        
      case 'Return':
        this.executeReturn();
        break;
        
      case 'OnGoto':
        this.executeOnGoto(stmt);
        break;
        
      case 'OnGosub':
        this.executeOnGosub(stmt);
        break;
        
      case 'Dim':
        this.executeDim(stmt);
        break;
        
      case 'End':
      case 'Stop':
        this.isRunning = false;
        break;
        
      case 'DefSingleLine':
      case 'DefMultiLine':
        // Already collected in first pass
        break;
        
      case 'FEnd':
        this.executeReturn();
        break;
    }
  }

  executePrint(stmt) {
    // Handle CLS (clear screen)
    if (stmt.clearScreen) {
      this.terminal.clear();
      return;
    }
    
    // Handle cursor positioning
    if (stmt.cursorRow !== null && stmt.cursorCol !== null) {
      const row = Math.floor(this.evaluateExpression(stmt.cursorRow));
      const col = Math.floor(this.evaluateExpression(stmt.cursorCol));
      this.terminal.setCursor(row, col);
    }
    
    let output = '';
    let col = 0;
    
    for (let i = 0; i < stmt.items.length; i++) {
      const value = this.evaluateExpression(stmt.items[i]);
      const formatted = this.formatValue(value);
      
      output += formatted;
      col += formatted.length;
      
      if (i < stmt.separators.length) {
        if (stmt.separators[i] === ';') {
          // Semicolon: no space
        } else if (stmt.separators[i] === ',') {
          // Comma: tab to next field (14-character fields)
          const nextTab = Math.floor(col / 14 + 1) * 14;
          const spaces = nextTab - col;
          output += ' '.repeat(spaces);
          col = nextTab;
        }
      }
    }
    
    this.terminal.println(output);
  }

  async executeInput(stmt) {
    const prompt = stmt.prompt || '?';
    this.inputPrompt = prompt;
    this.inputVariables = stmt.variables;
    
    return new Promise((resolve) => {
      this.waitingForInput = true;
      this.inputCallback = (inputText) => {
        this.processInput(inputText, stmt.variables);
        this.waitingForInput = false;
        this.inputCallback = null;
        resolve();
      };
      
      this.terminal.print(prompt + ' ');
    });
  }

  processInput(inputText, variables) {
    const fields = inputText.split(',').map(f => f.trim());
    
    if (fields.length !== variables.length) {
      this.terminal.println('?Redo from start');
      this.terminal.print(this.inputPrompt + ' ');
      return;
    }
    
    try {
      fields.forEach((field, index) => {
        const varName = variables[index];
        
        if (varName.endsWith('$')) {
          let value = field;
          if (value.startsWith('"') && value.endsWith('"')) {
            value = value.slice(1, -1);
          }
          this.variables.set(varName, value);
        } else {
          const value = parseFloat(field);
          if (isNaN(value)) {
            throw new Error('Invalid numeric input');
          }
          this.variables.set(varName, value);
        }
      });
    } catch (error) {
      this.terminal.println('?Redo from start');
      this.terminal.print(this.inputPrompt + ' ');
    }
  }

  executeAssignment(stmt) {
    const value = this.evaluateExpression(stmt.expression);
    
    if (stmt.subscripts.length > 0) {
      // Array assignment
      const indices = stmt.subscripts.map(s => Math.floor(this.evaluateExpression(s)));
      this.setArrayElement(stmt.variable, indices, value);
    } else {
      // Simple variable
      this.variables.set(stmt.variable, value);
    }
  }

  executeIf(stmt) {
    const condition = this.evaluateExpression(stmt.condition);
    
    if (this.isTruthy(condition)) {
      stmt.thenBranch.forEach(s => this.executeStatement(s));
    } else if (stmt.elseBranch.length > 0) {
      stmt.elseBranch.forEach(s => this.executeStatement(s));
    }
  }

  executeFor(stmt) {
    const start = this.evaluateExpression(stmt.start);
    const end = this.evaluateExpression(stmt.end);
    const step = this.evaluateExpression(stmt.step);
    
    this.variables.set(stmt.variable, start);
    
    this.forStack.push({
      variable: stmt.variable,
      end: end,
      step: step,
      loopStart: this.programCounter
    });
  }

  executeNext(stmt) {
    if (this.forStack.length === 0) {
      throw new Error('NEXT without FOR');
    }
    
    const loop = this.forStack[this.forStack.length - 1];
    
    // Increment variable
    const current = this.variables.get(loop.variable) || 0;
    const newValue = current + loop.step;
    this.variables.set(loop.variable, newValue);
    
    // Check if we should continue
    const shouldContinue = loop.step > 0 
      ? newValue <= loop.end 
      : newValue >= loop.end;
    
    if (shouldContinue) {
      // Jump back to FOR statement
      this.programCounter = loop.loopStart;
    } else {
      // Exit loop
      this.forStack.pop();
    }
  }

  executeWhile(stmt) {
    const condition = this.evaluateExpression(stmt.condition);
    
    if (this.isTruthy(condition)) {
      this.whileStack.push(this.programCounter);
    } else {
      // Skip to WEND
      let depth = 1;
      while (this.programCounter < this.statements.length && depth > 0) {
        this.programCounter++;
        const s = this.statements[this.programCounter];
        if (s && s.type === 'While') depth++;
        if (s && s.type === 'Wend') depth--;
      }
    }
  }

  executeWend() {
    if (this.whileStack.length === 0) {
      throw new Error('WEND without WHILE');
    }
    
    const whilePos = this.whileStack[this.whileStack.length - 1];
    const whileStmt = this.statements[whilePos];
    const condition = this.evaluateExpression(whileStmt.condition);
    
    if (this.isTruthy(condition)) {
      this.programCounter = whilePos;
    } else {
      this.whileStack.pop();
    }
  }

  executeGoto(stmt) {
    const labelIndex = this.labels.get(stmt.label);
    
    if (labelIndex === undefined) {
      throw new Error(`Label not found: ${stmt.label}`);
    }
    
    this.programCounter = labelIndex - 1;
  }

  executeGosub(stmt) {
    const labelIndex = this.labels.get(stmt.label);
    
    if (labelIndex === undefined) {
      throw new Error(`Label not found: ${stmt.label}`);
    }
    
    this.callStack.push(this.programCounter);
    this.programCounter = labelIndex - 1;
  }

  executeReturn() {
    if (this.callStack.length > 0) {
      this.programCounter = this.callStack.pop();
    } else {
      this.isRunning = false;
    }
  }

  executeOnGoto(stmt) {
    const value = Math.floor(this.evaluateExpression(stmt.expression));
    
    if (value >= 1 && value <= stmt.labels.length) {
      const label = stmt.labels[value - 1];
      const labelIndex = this.labels.get(label);
      
      if (labelIndex !== undefined) {
        this.programCounter = labelIndex - 1;
      }
    }
  }

  executeOnGosub(stmt) {
    const value = Math.floor(this.evaluateExpression(stmt.expression));
    
    if (value >= 1 && value <= stmt.labels.length) {
      const label = stmt.labels[value - 1];
      const labelIndex = this.labels.get(label);
      
      if (labelIndex !== undefined) {
        this.callStack.push(this.programCounter);
        this.programCounter = labelIndex - 1;
      }
    }
  }

  executeDim(stmt) {
    stmt.arrays.forEach(arr => {
      const dimensions = arr.dimensions.map(d => Math.floor(this.evaluateExpression(d)));
      this.createArray(arr.name, dimensions);
    });
  }

  createArray(name, dimensions) {
    const createMultiDim = (dims, index) => {
      if (index >= dims.length) {
        return 0;
      }
      
      const size = dims[index] + 1; // BASIC arrays are 0-indexed but size is dimension+1
      const arr = new Array(size);
      
      if (index === dims.length - 1) {
        arr.fill(0);
      } else {
        for (let i = 0; i < size; i++) {
          arr[i] = createMultiDim(dims, index + 1);
        }
      }
      
      return arr;
    };
    
    const array = createMultiDim(dimensions, 0);
    this.arrays.set(name, { dimensions, data: array });
  }

  getArrayElement(name, indices) {
    const arr = this.arrays.get(name);
    if (!arr) {
      // Auto-dimension if not explicitly DIMmed
      const dims = indices.map(() => 10); // Default size
      this.createArray(name, dims);
      return this.getArrayElement(name, indices);
    }
    
    let current = arr.data;
    for (let i = 0; i < indices.length; i++) {
      const index = Math.floor(indices[i]);
      if (index < 0 || index >= current.length) {
        return 0; // Out of bounds returns 0
      }
      current = current[index];
    }
    
    return current;
  }

  setArrayElement(name, indices, value) {
    const arr = this.arrays.get(name);
    if (!arr) {
      // Auto-dimension
      const dims = indices.map(() => 10);
      this.createArray(name, dims);
      return this.setArrayElement(name, indices, value);
    }
    
    let current = arr.data;
    for (let i = 0; i < indices.length - 1; i++) {
      const index = Math.floor(indices[i]);
      current = current[index];
    }
    
    const lastIndex = Math.floor(indices[indices.length - 1]);
    current[lastIndex] = value;
  }

  evaluateExpression(expr) {
    if (!expr) return 0;
    
    switch (expr.type) {
      case 'Number':
        return expr.value;
        
      case 'String':
        return expr.value;
        
      case 'Variable':
        return this.variables.get(expr.name) || 0;
        
      case 'BinaryOp':
        return this.evaluateBinaryOp(expr);
        
      case 'UnaryOp':
        return this.evaluateUnaryOp(expr);
        
      case 'LogicalOp':
        return this.evaluateLogicalOp(expr);
        
      case 'BuiltinCall':
        return this.evaluateBuiltin(expr);
        
      case 'ArrayOrFunction':
        // Try function first, then array
        if (this.functions.has(expr.name) || expr.name.startsWith('FN')) {
          return this.evaluateFunctionCall(expr);
        } else {
          const indices = expr.arguments.map(a => this.evaluateExpression(a));
          return this.getArrayElement(expr.name, indices);
        }
        
      default:
        throw new Error(`Unknown expression type: ${expr.type}`);
    }
  }

  evaluateBinaryOp(expr) {
    const left = this.evaluateExpression(expr.left);
    const right = this.evaluateExpression(expr.right);
    
    switch (expr.operator) {
      case '+':
        return typeof left === 'string' || typeof right === 'string'
          ? String(left) + String(right)
          : left + right;
      case '-':
        return left - right;
      case '*':
        return left * right;
      case '/':
        return left / right;
      case '^':
        return Math.pow(left, right);
      case '<':
        return left < right ? -1 : 0;
      case '>':
        return left > right ? -1 : 0;
      case '<=':
        return left <= right ? -1 : 0;
      case '>=':
        return left >= right ? -1 : 0;
      case '=':
        return left === right ? -1 : 0;
      case '<>':
        return left !== right ? -1 : 0;
      case 'MOD':
        return left % right;
      default:
        throw new Error(`Unknown operator: ${expr.operator}`);
    }
  }

  evaluateUnaryOp(expr) {
    const operand = this.evaluateExpression(expr.operand);
    
    switch (expr.operator) {
      case '-':
        return -operand;
      case 'NOT':
        return operand === 0 ? -1 : 0;
      default:
        throw new Error(`Unknown unary operator: ${expr.operator}`);
    }
  }

  evaluateLogicalOp(expr) {
    const left = this.evaluateExpression(expr.left);
    const right = this.evaluateExpression(expr.right);
    
    switch (expr.operator) {
      case 'AND':
        return (left !== 0 && right !== 0) ? -1 : 0;
      case 'OR':
        return (left !== 0 || right !== 0) ? -1 : 0;
      default:
        throw new Error(`Unknown logical operator: ${expr.operator}`);
    }
  }

  evaluateBuiltin(expr) {
    const name = expr.name;
    const args = expr.arguments.map(a => this.evaluateExpression(a));
    
    switch (name) {
      // Math functions
      case 'RND':
        // RND(1) generates random 0-1
        this.rndSeed = (this.rndSeed * 9301 + 49297) % 233280;
        return this.rndSeed / 233280;
        
      case 'INT':
        return Math.floor(args[0] || 0);
        
      case 'SQR':
        return Math.sqrt(args[0] || 0);
        
      case 'ABS':
        return Math.abs(args[0] || 0);
        
      case 'SGN':
        const val = args[0] || 0;
        return val > 0 ? 1 : val < 0 ? -1 : 0;
        
      case 'SIN':
        return Math.sin(args[0] || 0);
        
      case 'COS':
        return Math.cos(args[0] || 0);
        
      case 'TAN':
        return Math.tan(args[0] || 0);
        
      case 'ATN':
        return Math.atan(args[0] || 0);
        
      case 'EXP':
        return Math.exp(args[0] || 0);
        
      case 'LOG':
        return Math.log(args[0] || 0);
        
      // String functions
      case 'LEFT$':
        const str1 = String(args[0] || '');
        const len1 = Math.floor(args[1] || 0);
        return str1.substring(0, len1);
        
      case 'RIGHT$':
        const str2 = String(args[0] || '');
        const len2 = Math.floor(args[1] || 0);
        return str2.substring(str2.length - len2);
        
      case 'MID$':
        const str3 = String(args[0] || '');
        const start = Math.floor(args[1] || 1) - 1; // BASIC is 1-indexed
        const len3 = args[2] ? Math.floor(args[2]) : str3.length;
        return str3.substring(start, start + len3);
        
      case 'LEN':
        return String(args[0] || '').length;
        
      case 'STR$':
        return String(args[0] || 0);
        
      case 'CHR$':
        const chrCode = Math.floor(args[0] || 0);
        // Handle special control characters
        if (chrCode === 26) {
          // CHR$(26) - Clear screen on VT-102
          this.terminal.clear();
          return '';
        }
        if (chrCode === 11) {
          // CHR$(11) - Vertical tab, treat as newline
          return '\n';
        }
        if (chrCode === 8) {
          // CHR$(8) - Backspace
          return '\b';
        }
        if (chrCode === 22) {
          // CHR$(22) - Reverse video (we'll ignore for now, just return empty)
          return '';
        }
        return String.fromCharCode(chrCode);
        
      case 'ASC':
        const s = String(args[0] || '');
        return s.length > 0 ? s.charCodeAt(0) : 0;
        
      case 'VAL':
        return parseFloat(String(args[0] || '0')) || 0;
        
      case 'TAB':
        const tabPos = Math.floor(args[0] || 0);
        return ' '.repeat(Math.max(0, tabPos));
        
      // User-defined functions (FNR, FND from Star Trek)
      case 'FNR':
      case 'FND':
        // Look for DEF FNR or DEF FND
        return this.evaluateFunctionCall({ name, arguments: expr.arguments });
        
      default:
        // Check if it's a user-defined function
        if (name.startsWith('FN')) {
          return this.evaluateFunctionCall({ name, arguments: expr.arguments });
        }
        throw new Error(`Unknown function: ${name}`);
    }
  }

  evaluateFunctionCall(expr) {
    const func = this.functions.get(expr.name);
    
    if (!func) {
      // Could be undefined function or array
      return 0;
    }
    
    if (func.type === 'DefSingleLine') {
      // Bind parameters
      const savedVars = new Map();
      
      func.parameters.forEach((param, index) => {
        if (this.variables.has(param)) {
          savedVars.set(param, this.variables.get(param));
        }
        
        const argValue = index < expr.arguments.length
          ? this.evaluateExpression(expr.arguments[index])
          : 0;
        
        this.variables.set(param, argValue);
      });
      
      const result = this.evaluateExpression(func.expression);
      
      // Restore variables
      func.parameters.forEach(param => {
        if (savedVars.has(param)) {
          this.variables.set(param, savedVars.get(param));
        } else {
          this.variables.delete(param);
        }
      });
      
      return result;
    }
    
    // Multi-line function - would need more complex handling
    return 0;
  }

  formatValue(value) {
    if (typeof value === 'number') {
      if (value >= 0) {
        return ' ' + value;
      }
      return String(value);
    }
    return String(value);
  }

  isTruthy(value) {
    if (typeof value === 'number') {
      return value !== 0;
    }
    if (typeof value === 'string') {
      return value.length > 0;
    }
    return Boolean(value);
  }
}

// ============================================================================
// TERMINAL CONTROLLER
// ============================================================================
class TerminalController {
  constructor(updateCallback) {
    this.lines = ['CB-80 BASIC Interpreter v2.0 - Star Trek Edition', 'Ready.', ''];
    this.cursorRow = 2;
    this.cursorCol = 0;
    this.inputBuffer = '';
    this.updateCallback = updateCallback;
  }

  print(text) {
    const textStr = String(text);
    
    if (textStr === '') {
      return;
    }
    
    const lines = textStr.split('\n');
    
    lines.forEach((line, index) => {
      if (index > 0) {
        // Newline: move to next line
        this.cursorRow++;
        this.cursorCol = 0;
        
        // Ensure we have a line at this position
        while (this.lines.length <= this.cursorRow) {
          this.lines.push('');
        }
      }
      
      // Print at current cursor position
      if (this.cursorRow >= this.lines.length) {
        this.lines.push('');
      }
      
      const currentLine = this.lines[this.cursorRow];
      const before = currentLine.substring(0, this.cursorCol);
      const after = currentLine.substring(this.cursorCol + line.length);
      
      this.lines[this.cursorRow] = before + line + after;
      this.cursorCol += line.length;
    });
    
    this.scrollIfNeeded();
    this.updateCallback();
  }

  println(text) {
    this.print(text);
    this.newline();
  }

  newline() {
    this.lines.push('');
    this.cursorRow++;
    this.cursorCol = 0;
    this.scrollIfNeeded();
    this.updateCallback();
  }

  scrollIfNeeded() {
    const MAX_LINES = 24;
    
    if (this.cursorRow >= MAX_LINES) {
      const linesToRemove = this.cursorRow - MAX_LINES + 1;
      this.lines.splice(0, linesToRemove);
      this.cursorRow = MAX_LINES - 1;
    }
  }

  clear() {
    this.lines = [''];
    this.cursorRow = 0;
    this.cursorCol = 0;
    this.updateCallback();
  }

  setCursor(row, col) {
    // Convert from 1-indexed (BASIC) to 0-indexed (internal)
    const targetRow = row - 1;
    const targetCol = col - 1;
    
    // Clamp to valid ranges
    this.cursorRow = Math.max(0, Math.min(23, targetRow));
    this.cursorCol = Math.max(0, Math.min(79, targetCol));
    
    // Ensure we have enough lines
    while (this.lines.length <= this.cursorRow) {
      this.lines.push('');
    }
    
    // Ensure current line is long enough
    if (this.lines[this.cursorRow].length < this.cursorCol) {
      this.lines[this.cursorRow] = this.lines[this.cursorRow].padEnd(this.cursorCol, ' ');
    }
    
    this.updateCallback();
  }

  handleInput(char) {
    if (char === 'Enter') {
      const command = this.inputBuffer;
      this.println(this.inputBuffer);
      this.inputBuffer = '';
      return command;
    } else if (char === 'Backspace') {
      if (this.inputBuffer.length > 0) {
        this.inputBuffer = this.inputBuffer.slice(0, -1);
        
        if (this.cursorCol > 0) {
          this.lines[this.cursorRow] = this.lines[this.cursorRow].slice(0, -1);
          this.cursorCol--;
          this.updateCallback();
        }
      }
      return null;
    } else if (char.length === 1) {
      this.inputBuffer += char;
      
      this.lines[this.cursorRow] = (this.lines[this.cursorRow] || '') + char;
      this.cursorCol++;
      this.updateCallback();
      return null;
    }
    
    return null;
  }

  getState() {
    return {
      lines: [...this.lines],
      cursorRow: this.cursorRow,
      cursorCol: this.cursorCol
    };
  }
}

// ============================================================================
// MAIN APPLICATION COMPONENT
// ============================================================================
export default function CB80InterpreterEnhanced() {
  const [terminalState, setTerminalState] = useState({ lines: [], cursorRow: 0, cursorCol: 0 });
  const [cursorVisible, setCursorVisible] = useState(true);
  const [currentProgram, setCurrentProgram] = useState('');
  const [isRunning, setIsRunning] = useState(false);
  
  const terminalRef = useRef(null);
  const interpreterRef = useRef(null);

  useEffect(() => {
    terminalRef.current = new TerminalController(() => {
      setTerminalState(terminalRef.current.getState());
    });
    
    setTerminalState(terminalRef.current.getState());
    
    interpreterRef.current = new Interpreter(terminalRef.current);
    
    const blinkInterval = setInterval(() => {
      setCursorVisible(prev => !prev);
    }, 500);
    
    return () => clearInterval(blinkInterval);
  }, []);

  useEffect(() => {
    const handleKeyDown = async (e) => {
      if (interpreterRef.current && interpreterRef.current.waitingForInput) {
        const result = terminalRef.current.handleInput(e.key);
        
        if (result !== null) {
          interpreterRef.current.inputCallback(result);
        }
        return;
      }
      
      if (isRunning) return;
      
      const result = terminalRef.current.handleInput(e.key);
      
      if (result !== null) {
        await handleCommand(result);
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [isRunning]);

  const handleCommand = async (command) => {
    const cmd = command.trim().toUpperCase();
    
    if (cmd === 'RUN') {
      if (currentProgram) {
        await runProgram(currentProgram);
      } else {
        terminalRef.current.println('No program loaded');
      }
    } else if (cmd === 'CLEAR' || cmd === 'CLS') {
      terminalRef.current.clear();
    } else if (cmd === 'LIST') {
      if (currentProgram) {
        terminalRef.current.println(currentProgram);
      } else {
        terminalRef.current.println('No program loaded');
      }
    } else if (cmd === 'NEW') {
      setCurrentProgram('');
      terminalRef.current.println('Ready.');
    } else {
      if (cmd.startsWith('PRINT ') || cmd.startsWith('INPUT ')) {
        await runProgram(command);
      } else {
        setCurrentProgram(prev => prev + (prev ? '\n' : '') + command);
        terminalRef.current.println('Ok');
      }
    }
  };

  const runProgram = async (program) => {
    setIsRunning(true);
    terminalRef.current.newline();
    
    try {
      const lexer = new Lexer(program);
      const tokens = lexer.tokenize();
      
      const parser = new Parser(tokens);
      const ast = parser.parse();
      
      await interpreterRef.current.execute(ast);
      
      terminalRef.current.newline();
      terminalRef.current.println('Ready.');
    } catch (error) {
      // Enhanced error display
      terminalRef.current.println('');
      terminalRef.current.println('='.repeat(70));
      terminalRef.current.println('ERROR DETECTED');
      terminalRef.current.println('='.repeat(70));
      terminalRef.current.println('');
      
      // Parse the error message
      const errorMsg = error.message;
      
      // Display the error
      if (errorMsg.includes('Syntax Error on line')) {
        // Already formatted error from lexer/parser
        terminalRef.current.println(errorMsg);
      } else if (errorMsg.includes('ERROR at statement')) {
        // Runtime error from interpreter
        terminalRef.current.println(errorMsg);
      } else {
        // Generic error
        terminalRef.current.println('Runtime Error:');
        terminalRef.current.println(errorMsg);
      }
      
      terminalRef.current.println('');
      terminalRef.current.println('='.repeat(70));
      terminalRef.current.println('');
      
      // Log full error to console for debugging
      console.error('Full error details:', error);
      console.error('Stack trace:', error.stack);
    }
    
    setIsRunning(false);
  };

  const handleEditorChange = (e) => {
    setCurrentProgram(e.target.value);
  };

  const handleRunClick = async () => {
    if (currentProgram.trim()) {
      terminalRef.current.println('Running program...');
      await runProgram(currentProgram);
    }
  };

  const handleClearClick = () => {
    terminalRef.current.clear();
  };

  const handleNewClick = () => {
    if (currentProgram.trim() && !confirm('Clear current program? Unsaved changes will be lost.')) {
      return;
    }
    setCurrentProgram('');
    terminalRef.current.println('New program');
  };

  const handleOpenClick = () => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = '.bas,.basic,.txt';
    
    input.onchange = (e) => {
      const file = e.target.files[0];
      if (!file) return;
      
      const reader = new FileReader();
      reader.onload = (event) => {
        setCurrentProgram(event.target.result);
        terminalRef.current.println(`Loaded: ${file.name}`);
      };
      reader.readAsText(file);
    };
    
    input.click();
  };

  const handleSaveAsClick = () => {
    if (!currentProgram.trim()) {
      terminalRef.current.println('Nothing to save');
      return;
    }
    
    const filename = prompt('Enter filename:', 'program.bas');
    if (!filename) return;
    
    const finalFilename = filename.endsWith('.bas') ? filename : `${filename}.bas`;
    
    const blob = new Blob([currentProgram], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = finalFilename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    
    terminalRef.current.println(`Saved: ${finalFilename}`);
  };

  return (
    <div className="min-h-screen bg-gray-900 p-8">
      <div className="max-w-7xl mx-auto">
        <h1 className="text-4xl font-bold text-green-400 mb-2 font-mono">
          CB-80 BASIC Interpreter v2.0
        </h1>
        <p className="text-gray-400 mb-6 font-mono text-sm">
          Star Trek Edition â€¢ Full Stage 2 & 3 Features â€¢ FOR/NEXT â€¢ GOSUB/RETURN â€¢ Arrays â€¢ Built-in Functions
        </p>
        
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div>
            <div className="flex justify-between items-center mb-2">
              <h2 className="text-xl font-semibold text-green-400 font-mono">Program Editor</h2>
              <div className="space-x-2">
                <button
                  onClick={handleNewClick}
                  className="px-3 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded font-mono text-sm"
                >
                  NEW
                </button>
                <button
                  onClick={handleOpenClick}
                  className="px-3 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded font-mono text-sm"
                >
                  OPEN
                </button>
                <button
                  onClick={handleSaveAsClick}
                  className="px-3 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded font-mono text-sm"
                >
                  SAVE AS
                </button>
                <button
                  onClick={handleRunClick}
                  disabled={isRunning}
                  className="px-4 py-2 bg-green-600 hover:bg-green-700 disabled:bg-gray-600 text-white rounded font-mono text-sm"
                >
                  RUN
                </button>
                <button
                  onClick={handleClearClick}
                  className="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded font-mono text-sm"
                >
                  CLEAR
                </button>
              </div>
            </div>
            <textarea
              value={currentProgram}
              onChange={handleEditorChange}
              className="w-full h-96 bg-gray-800 text-green-400 font-mono text-sm p-4 rounded-lg border-2 border-green-600 focus:outline-none focus:border-green-400"
              placeholder="Enter your CB-80 BASIC program here..."
              spellCheck={false}
            />
            
            <div className="mt-4 p-4 bg-gray-800 rounded-lg">
              <h3 className="text-sm font-semibold text-green-400 font-mono mb-2">ðŸš€ NEW in v2.0</h3>
              <div className="text-xs text-gray-400 font-mono space-y-1">
                <p><span className="text-green-400">FOR...NEXT</span> - Loops with STEP</p>
                <p><span className="text-green-400">GOSUB/RETURN</span> - Subroutines</p>
                <p><span className="text-green-400">DIM</span> - Multi-dimensional arrays</p>
                <p><span className="text-green-400">ON...GOTO</span> - Computed jumps</p>
                <p><span className="text-green-400">RND, INT, SQR</span> - Math functions</p>
                <p><span className="text-green-400">LEFT$, RIGHT$, MID$</span> - String functions</p>
                <p><span className="text-yellow-400">â­ Ready for Star Trek!</span></p>
              </div>
            </div>
          </div>
          
          <div>
            <h2 className="text-xl font-semibold text-green-400 font-mono mb-2">VT-102 Terminal</h2>
            <VT102Terminal
              lines={terminalState.lines}
              cursorRow={terminalState.cursorRow}
              cursorCol={terminalState.cursorCol}
              cursorVisible={cursorVisible && !isRunning}
            />
          </div>
        </div>
      </div>
    </div>
  );
}